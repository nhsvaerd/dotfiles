#!/bin/bash

echo "Running YADM Bootstrap..."

# -----------------------------------
# DEFINE PATH TO PACKAGE LIST
# -----------------------------------
CLI_PACKAGE_LIST="$HOME/.config/yadm/packages-cli.txt"

# -----------------------------------
# INSTALL ESSENTIAL CLI PACKAGES
# -----------------------------------
echo "📦 Installing essential CLI tools..."
sudo apt-get update

if [[ -f "$CLI_PACKAGE_LIST" ]]; then
    while read -r package; do
        [[ -z "$package" || "$package" == "#"* ]] && continue  # Skip empty lines and comments
        echo "📦 Installing: $package"
        if ! sudo apt-get install -y "$package"; then
            echo "❌ Failed to install: $package" >&2
        else
            echo "✅ Installed: $package"
        fi
    done < "$CLI_PACKAGE_LIST"
else
    echo "⚠️ No CLI package list found. Skipping essential package installation."
fi

# -----------------------------------
# FETCH REMOTE BRANCHES AND PROMPT USER
# -----------------------------------
yadm fetch --all
CURRENT_BRANCH=$(yadm branch --show-current)
AVAILABLE_BRANCHES=$(yadm branch -r | grep -vE "HEAD" | sed 's|origin/||' | sort -u)

echo "Available setup profiles:"
PS3="Select a branch to configure the system: "
select SELECTED_BRANCH in $AVAILABLE_BRANCHES "Skip"; do
    if [[ -n "$SELECTED_BRANCH" && "$SELECTED_BRANCH" != "Skip" ]]; then
        echo "✅ Selected branch: $SELECTED_BRANCH"
        break
    elif [[ "$SELECTED_BRANCH" == "Skip" ]]; then
        echo "Skipping additional configurations."
        exit 0
    else
        echo "❌ Invalid selection. Please try again."
    fi
done

# -----------------------------------
# SWITCH TO SELECTED BRANCH
# -----------------------------------
if [[ "$SELECTED_BRANCH" != "$CURRENT_BRANCH" ]]; then
    echo "🌐 Switching to branch: $SELECTED_BRANCH..."
    if ! yadm rev-parse --verify "$SELECTED_BRANCH" &>/dev/null; then
        yadm checkout -t origin/"$SELECTED_BRANCH"
    else
        yadm checkout "$SELECTED_BRANCH"
    fi

    echo "🔄 Pulling latest updates..."
    if ! yadm pull --rebase; then
        echo "❌ Error: Failed to pull latest changes. Exiting."
        exit 1
    fi
fi
echo "✅ Repository is up to date!"

# -----------------------------------
# EXECUTE BRANCH-SPECIFIC SETUP SCRIPT
# -----------------------------------
SETUP_SCRIPT="$HOME/.config/yadm/setup.sh"
if [[ -f "$SETUP_SCRIPT" ]]; then
    chmod +x "$SETUP_SCRIPT"
    echo "🔧 Running branch-specific setup..."
    exec "$SETUP_SCRIPT"
else
    echo "⚠️ No setup script found at $SETUP_SCRIPT. Skipping setup."
fi
