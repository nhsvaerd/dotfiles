#!/bin/bash

echo "Running YADM bootstrap script..."

# Define essential packages
ESSENTIAL_PACKAGES=(
    curl
    wget
    mc
    micro
    btop
    tldr
    apt-fast
    rsync
    syncthing
)

# Install essential APT packages
echo "📦 Installing essential packages..."
sudo apt update
for pkg in "${ESSENTIAL_PACKAGES[@]}"; do
    echo "Installing: $pkg"
    sudo apt install -y "$pkg"
done

# Fetch all remote branches
yadm fetch --all

# Detect current branch
CURRENT_BRANCH=$(yadm branch --show-current)

# List remote branches (remote only, excluding HEAD)
AVAILABLE_BRANCHES=$(yadm ls-remote --heads | awk -F'/' '{print $3}')

# Prompt user to select a branch
echo "Available setup profiles:"
PS3="Select a branch to configure the system: "
select SELECTED_BRANCH in $AVAILABLE_BRANCHES "Skip"; do
    if [[ -n "$SELECTED_BRANCH" && "$SELECTED_BRANCH" != "Skip" ]]; then
        echo "✅ Selected branch: $SELECTED_BRANCH"
        break
    elif [[ "$SELECTED_BRANCH" == "Skip" ]]; then
        echo "Skipping additional configurations."
        exit 0
    else
        echo "❌ Invalid selection. Please try again."
    fi
done

# Checkout the selected branch if different from the current one
if [[ "$SELECTED_BRANCH" != "$CURRENT_BRANCH" ]]; then
    echo "🌐 Switching to branch: $SELECTED_BRANCH..."
    if ! yadm rev-parse --verify "$SELECTED_BRANCH" &>/dev/null; then
        yadm checkout -t origin/"$SELECTED_BRANCH"
    else
        yadm checkout "$SELECTED_BRANCH"
    fi

    echo "🔄 Pulling latest updates..."
    if ! yadm pull --rebase; then
        echo "❌ Error: Failed to pull latest changes. Exiting."
        exit 1
    fi
fi
echo "✅ Repository is up to date!"

# Ensure setup script exists
SETUP_SCRIPT="$HOME/.config/yadm/setup.sh"
if [[ ! -f "$SETUP_SCRIPT" ]]; then
    echo "⚠️ No setup script found at $SETUP_SCRIPT. Skipping further setup."
    exit 0
fi

# Make setup script executable if needed
chmod +x "$SETUP_SCRIPT"

# Run setup script
echo "🔧 Running environment setup..."
exec "$SETUP_SCRIPT"

echo "✅ Bootstrap complete"
